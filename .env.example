# Where new counselling requests are sent. Leave empty until the CRM exists:
# leads are then only written to the server log (Vercel > Logs), not lost silently.
CRM_WEBHOOK_URL=
# Optional. Sent to the CRM as "Authorization: Bearer <secret>".
CRM_WEBHOOK_SECRET=

# Rewards: "Continue with Google" (Web OAuth client id, from console.cloud.google.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Rewards: signs the session cookie. Random, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
REWARDS_SESSION_SECRET=
